# ==============================================================================
# FIXMATE — Environment Configuration
# ==============================================================================
# Privacy-first, zero-paid-API everyday problem-solving application.
# All data is stored locally in SQLite and analyzed using local Ollama models.
# ==============================================================================

# Database: Local SQLite via Prisma
DATABASE_URL="file:./dev.db"

# Local AI: Ollama Runtime (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_VISION_MODEL="llama3.2-vision"
OLLAMA_TIMEOUT_MS="30000"

# Application Settings
NODE_ENV="development"
PORT="3000"
UPLOAD_MAX_FILE_SIZE_MB="25"
ENABLE_FALLBACK_DETERMINISTIC_PARSER="true"

